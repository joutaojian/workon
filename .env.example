# workon 运行时配置示例。复制为 .env 并按需要修改（.env 已被 .gitignore 忽略）。

# 数据目录（执行记录 SQLite 与临时运行目录都放这里，默认 data/）
WORKON_DATA_DIR=data

# Web 服务监听地址与端口
WORKON_HOST=0.0.0.0
WORKON_PORT=8080

# 单个技能默认超时（秒）
WORKON_TIMEOUT=120

# 上传文件大小上限（MB）
WORKON_MAX_UPLOAD_MB=50

# 额外技能目录，多个用分号分隔，指向你的私有 git 技能仓库
# 例：WORKON_SKILL_DIRS=D:/git/my-private-skills;D:/git/team-skills
WORKON_SKILL_DIRS=

# 允许执行的命令白名单（分号分隔）
WORKON_ALLOWED_COMMANDS=python;python3;node;bash;sh;powershell;pwsh

# 调试模式（生产请勿开启）
WORKON_DEBUG=false
