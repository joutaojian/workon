{
  "id": "text-tidy",
  "name": "文本整理（官方）",
  "description": "官方内置能力，整理纯文本文档：清空行、去行首尾空格、合并连续空行、批量替换词句。适合交稿前统一格式、批量改称呼/日期。纯 Python 标准库实现，无需联网或第三方依赖。",
  "version": "1.0.0",
  "author": "workon",
  "official": true,
  "tags": ["official", "text", "tidy", "office"],
  "inputs": [
    {
      "name": "files",
      "type": "file",
      "ext": ["txt", "md", "csv", "log"],
      "required": true,
      "multiple": true,
      "description": "一个或多个文本文件（txt / md / csv / log）。"
    }
  ],
  "params": [
    {
      "name": "find",
      "type": "string",
      "default": "",
      "description": "要替换掉的词句（留空则只整理格式、不替换）。"
    },
    {
      "name": "replace",
      "type": "string",
      "default": "",
      "description": "替换成的新词句。"
    }
  ],
  "outputs": [
    {
      "name": "files",
      "type": "dir",
      "path": "tidied",
      "description": "整理后的文件目录。"
    },
    {
      "name": "summary",
      "type": "text",
      "description": "处理摘要。"
    }
  ],
  "entry": {
    "command": "python",
    "args": ["run.py", "--inputs", "{files}", "--find", "{find}", "--replace", "{replace}"]
  },
  "timeout_seconds": 120,
  "dependencies": []
}
